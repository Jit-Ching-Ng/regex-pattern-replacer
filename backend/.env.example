# --- Django ---------------------------------------------------------------
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated list, only needed when the frontend runs on another origin.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Optional: postgres://user:pass@host:5432/db  (defaults to SQLite)
# DATABASE_URL=
# Where uploaded files and dataset snapshots are stored.
# DATA_DIR=./data

# --- LLM ------------------------------------------------------------------
# "anthropic" or "openai" (any OpenAI-compatible API: OpenAI, Groq, Together,
# OpenRouter, a local Ollama server, ...)
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Leave empty to use the provider default (see processor/services/llm.py).
LLM_MODEL=
# Only for OpenAI-compatible providers, e.g. https://api.groq.com/openai/v1
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=45
# Send a few sample cell values per column so the LLM can tailor the regex.
LLM_SEND_SAMPLE_VALUES=true

# --- Limits ---------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=50
MAX_ROWS=1000000
REGEX_CELL_TIMEOUT_SECONDS=0.5
OPERATION_TIME_BUDGET_SECONDS=90
TRANSFORM_MAX_UNIQUE_VALUES=500
TRANSFORM_BATCH_SIZE=40
